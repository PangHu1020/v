# =============================================================================
#  .env — SECRETS and DEPLOYMENT-SPECIFIC values only.
#
#  Non-secret tunables (model names, thresholds, TTLs, shard counts) live in
#  config.yaml — edit that to change behaviour without touching code.
#
#  Precedence (highest wins):  env var  >  .env  >  config.yaml  >  code default
#  Anything set here overrides config.yaml, so keep this file lean.
# =============================================================================

# ── Chat LLM (primary + fallback endpoints) ──────────────────────────────
# Two independent endpoints so primary and fallback can be different providers.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL_FALLBACK=
LLM_API_KEY_FALLBACK=
LLM_MODEL_FALLBACK=

# ── Embedding (independent from chat) ────────────────────────────────────
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# ── Postgres (single instance, schemas: agent / dw / meta) ───────────────
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/agent

# ── Redis (bus + working memory + checkpointer + pub/sub outbound) ───────
REDIS_URL=redis://localhost:6379/0

# ── Milvus vector store ──────────────────────────────────────────────────
MILVUS_URI=
MILVUS_TOKEN=

# ── RAG reranker endpoint ────────────────────────────────────────────────
RAG_RERANK_URL=
RAG_RERANK_MODEL=bge-reranker-v2-m3
# RAG_RERANK_API_KEY=  # only needed for remote hosted reranker

# ── Eval RAGAS judge (offline; decoupled from the agent-under-test) ───────
# OpenAI-compatible endpoint for the LLM that scores RAGAS generation metrics.
# Empty → the conversational eval falls back to the agent's own LLM endpoint.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=

# --- WeCom 智能机器人 WebSocket worker (secrets) ---
# ws_url / bot_id / secret authenticate the aibot_subscribe handshake.
# Leave WECOM_AIBOT_WS_URL empty to disable the WS worker.
WECOM_AIBOT_WS_URL=
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=

# --- LangSmith tracing (api_key is a secret; project/endpoint in config.yaml) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# --- Optional: point at a non-default config file ---
# APP_CONFIG_FILE=config.yaml
