# --- runtime ---
APP_ENV=dev
APP_LOG_LEVEL=INFO

# --- LangSmith tracing (optional) ---
# Set LANGSMITH_TRACING=true and provide an API key to ship every graph /
# LLM invocation to https://smith.langchain.com under LANGSMITH_PROJECT.
# Leave blank to disable (zero overhead).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=v-main
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- LLM routing ---
# TODO: connect private proxy that exposes deepseek-chat-v4-pro / deepseek-chat-v4-flash.
# For local development against the public DeepSeek API, replace LLM_MAIN_PRIMARY/FALLBACK
# with `deepseek-chat` and `deepseek-reasoner` and point LLM_BASE_URL_DEEPSEEK at
# https://api.deepseek.com/v1.
LLM_BASE_URL_DEEPSEEK=
LLM_API_KEY_DEEPSEEK=
LLM_BASE_URL_QWEN=
LLM_API_KEY_QWEN=
LLM_MAIN_PRIMARY=deepseek-chat-v4-pro
LLM_MAIN_FALLBACK=deepseek-chat-v4-flash
LLM_TIMEOUT_SECONDS=30

# --- Embedding (uses LLM_*_QWEN credentials at call time) ---
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# --- Postgres (single instance, schemas: agent / dw / meta) ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/agent

# --- Redis (shared by bus + working memory + checkpointer) ---
REDIS_URL=redis://localhost:6379/0

# --- Memory (Phase-3 三层记忆 + mid-session compression + emotion) ---
# Working layer (Redis hash) TTL — also serves as the "30-min-silence
# session boundary" used to mint new session_ids.
MEMORY_WORKING_TTL_SECONDS=1800
# Medium-term event-memory rows (PG) — purged after this many days.
MEMORY_EVENT_TTL_DAYS=30
# How many recent events to inject into the system prompt at session start.
MEMORY_RECENT_EVENTS_TO_INJECT=3
# When the running token count exceeds this, the compression node fires
# mid-session. Set to 0 to disable (no compression).
MEMORY_COMPRESSION_THRESHOLD_TOKENS=4000
# How many trailing messages to keep verbatim when compression fires.
MEMORY_COMPRESSION_KEEP_RECENT_MESSAGES=4
# Anger/frustration score above which intent_node pre-empts to
# transfer_to_human without calling the LLM. Set to 1.0 to disable.
MEMORY_EMOTION_THRESHOLD=0.80
# HTTP endpoint of a remote BERT emotion model. Empty falls back to the
# in-process keyword scorer (safe default for dev/MVP).
MEMORY_EMOTION_SERVICE_URL=

# --- Bus (Redis Streams, sharded by (channel, channel_user_id)) ---
BUS_STREAM_PREFIX=bus
BUS_SHARD_COUNT=64
BUS_CONSUMER_GROUP=workers
BUS_DEBOUNCE_MS=500

# --- WeCom (customer-side, HTTP webhook) ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# --- WeCom 智能机器人 (WebSocket worker, Phase-3 Group G) ---
# Standalone process holding a persistent WebSocket. Auth uses the
# ``aibot_subscribe`` handshake — bot_id + secret posted as the first
# frame after connect, NOT an Authorization header.
# Outbound replies are funnelled through Redis pub/sub so any process
# can publish.
WECOM_AIBOT_WS_URL=
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_HEARTBEAT_SECONDS=30
WECOM_AIBOT_OUTBOUND_PUBSUB_CHANNEL=wecom_aibot:outbound

# --- Feishu (customer-side) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# --- Slack (operator-side, Phase-2 P0) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_HANDOFF_CHANNEL_ID=

# --- MCP (Phase-2 P1) ---
# JSON array of server configs. Each entry: {id, transport, ...transport-specific}.
# stdio  : {"id":"products","transport":"stdio","command":"python","args":["-m","products_mcp"]}
# http   : {"id":"ads","transport":"http","url":"https://ads/mcp","auth_type":"api_key","api_key":"sk"}
# Per-server "write_tools": ["place_order","cancel"] opts those tools out of cache.
MCP_SERVERS_JSON=[]
MCP_CACHE_L1_TTL_SECONDS=300
MCP_CACHE_L2_TTL_SECONDS=86400
MCP_CALL_TIMEOUT_SECONDS=30

# --- ARQ cron worker (Phase-2 P2) ---
# Empty ARQ_REDIS_URL falls back to REDIS_URL.
ARQ_REDIS_URL=
ARQ_QUEUE_NAME=arq:queue
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT_SECONDS=120

# --- Skills (Phase-2 P4 — markdown SOPs prepended on intent match) ---
# Filesystem path to the directory holding markdown skills. Empty
# disables the loader.
SKILL_INTERNAL_REPO_PATH=
# Top-K skills to inject per turn; 0 disables injection.
SKILL_MAX_SKILLS_PER_TURN=3

# --- Milvus ---
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=knowledge_chunks

# --- RAG parameters ---
RAG_MIN_SCORE=0.65
RAG_MIN_K=3
RAG_DENSE_WEIGHT=0.5
RAG_BM25_WEIGHT=0.5

# --- Phase-2 placeholders (leave blank in Phase-1) ---
# SKILL_COMMUNITY_WHITELIST=
